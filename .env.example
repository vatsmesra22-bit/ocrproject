# Copy this file to .env and fill in the values. Never commit .env.

# development | production
APP_ENV=development
# Long random string used to sign CSP login sessions
SECRET_KEY=change-me

# App under a sub-path of the server, e.g. https://host/ocrproject/ -> /ocrproject (empty = root)
EKO_BASE_PATH=

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs

# Logins, list counts and the STOP list (no customer lists - those stay on the CSP's phone).
DATA_DIR=data
# DPDP: lists are deleted from the CSP's phone this many days after upload
RETENTION_DAYS=30
# Audit log (no names / full numbers) is kept longer - DPDP Rules 2025, confirm with compliance
AUDIT_RETENTION_DAYS=365
# Login lock after LOGIN_MAX_FAILED wrong passwords, for LOGIN_LOCKOUT_MINUTES (0 = off).
# Keep it ON (15) on the live server - it stops password guessing.
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15
# Rows read with lower OCR confidence than this are flagged for the CSP to check
OCR_MIN_CONFIDENCE=0.80

# Hashes the numbers of customers who said STOP. Set once to a long random string;
# NEVER change after go-live.
OPTOUT_KEY=

# DPDP: grievance officer contact shown to customers (email / phone). Fill before go-live.
GRIEVANCE_CONTACT=

# Reminder shown on the CSP's phone FOLLOWUP_DAYS after the message, at most MAX_FOLLOWUPS times
FOLLOWUP_DAYS=7
MAX_FOLLOWUPS=1

# OCR engine: local (offline) or voxomos (in-house OCR service - only after DPDP clearance)
OCR_ENGINE=local
VOXOMOS_URL=
VOXOMOS_API_KEY=
VOXOMOS_TIMEOUT=120
